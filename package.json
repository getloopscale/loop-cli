{
  "name": "@getloopscale/loop-cli",
  "version": "0.2.0",
  "description": "CLI-first deploys for LoopScale: one command from monorepo to running service.",
  "keywords": [
    "cli",
    "deploy",
    "deployment",
    "kubernetes",
    "monorepo",
    "paas",
    "devops",
    "loopscale"
  ],
  "homepage": "https://getloopscale.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getloopscale/loop-cli.git"
  },
  "bugs": {
    "url": "https://github.com/getloopscale/loop-cli/issues"
  },
  "main": "dist/index.js",
  "bin": {
    "loopscale": "./bin/loopscale"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:unit": "jest tests/unit/",
    "test:contract": "jest tests/contract/",
    "test:integration": "jest tests/integration/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^1.26.0",
    "@opentelemetry/sdk-trace-node": "^1.26.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "commander": "^12.1.0",
    "ignore": "^7.0.5",
    "js-yaml": "^4.1.0",
    "tar": "^7.5.13"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/tar": "^6.1.13",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "knip": "^6.11.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
